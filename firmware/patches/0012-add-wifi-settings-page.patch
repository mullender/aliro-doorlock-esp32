     "}else{render();}"
     "})();"
     "</script>"
+    "<script>"
+    "(function(){"
+    "var KEYS=['auto_relock_seconds','success_rgb','success_ms',"
+    "'failure_rgb','failure_ms','other_rgb','other_ms'];"
+    "var INT_LIMITS={"
+    "auto_relock_seconds:[0,3600],"
+    "success_ms:[0,10000],"
+    "failure_ms:[0,10000],"
+    "other_ms:[0,10000]"
+    "};"
+    "var isRgbKey=function(k){return k.slice(-4)==='_rgb';};"
+    "var isSixHex=function(s){return typeof s==='string'&&/^[0-9a-f]{6}$/i.test(s);};"
+    "var isIntInRange=function(v,lo,hi){"
+    "return typeof v==='number'&&isFinite(v)&&Math.floor(v)===v&&v>=lo&&v<=hi;"
+    "};"
+    "var setStatus=function(text,isError){"
+    "var el=document.getElementById('settings-status');"
+    "el.textContent=text;"
+    "el.style.color=isError?'#a11':'';"
+    "};"
+    "var populate=function(data){"
+    "if(!data||typeof data!=='object'){setStatus('Settings: invalid response.',true);return false;}"
+    "for(var i=0;i<KEYS.length;i++){"
+    "var k=KEYS[i];var v=data[k];"
+    "var input=document.getElementById('s-'+k);"
+    "if(!input){setStatus('Settings: invalid response.',true);return false;}"
+    "if(isRgbKey(k)){"
+    "var hex=typeof v==='string'?v.replace(/^#/,''):'';"
+    "if(!isSixHex(hex)){setStatus('Settings: invalid response.',true);return false;}"
+    "input.value='#'+hex.toLowerCase();"
+    "}else{"
+    "var lim=INT_LIMITS[k];"
+    "if(!lim||!isIntInRange(v,lim[0],lim[1])){"
+    "setStatus('Settings: invalid response.',true);return false;"
+    "}"
+    "input.value=String(v);"
+    "}"
+    "}"
+    "return true;"
+    "};"
+    "var load=function(){"
+    "setStatus('Loading settings\\u2026');"
+    "fetch('/api/settings').then(function(r){"
+    "if(!r.ok)throw new Error('HTTP '+r.status);"
+    "return r.json();"
+    "}).then(function(d){"
+    "if(populate(d))setStatus('Settings loaded.');"
+    "}).catch(function(err){"
+    "setStatus('Settings load failed: '+err.message,true);"
+    "});"
+    "};"
+    "var submit=function(ev){"
+    "ev.preventDefault();"
+    "var form=document.getElementById('settings-form');"
+    // Native constraint validation runs first: honours the number
+    // input min/max and required attributes.
+    "if(form.reportValidity&&!form.reportValidity()){"
+    "setStatus('Settings not saved: fix the highlighted fields.',true);return;"
+    "}"
+    "var params=new URLSearchParams();"
+    "for(var i=0;i<KEYS.length;i++){"
+    "var k=KEYS[i];"
+    "var input=document.getElementById('s-'+k);"
+    "if(!input){setStatus('Settings not saved: form field missing.',true);return;}"
+    "var val=input.value;"
+    "if(isRgbKey(k)){"
+    "var hex=String(val).replace(/^#/,'');"
+    "if(!isSixHex(hex)){setStatus('Settings not saved: invalid '+k+'.',true);return;}"
+    "params.append(k,hex);"
+    "}else{"
+    "if(val===''||val===null){"
+    "setStatus('Settings not saved: '+k+' is required.',true);return;"
+    "}"
+    "var n=Number(val);"
+    "var lim=INT_LIMITS[k];"
+    "if(!lim||!isIntInRange(n,lim[0],lim[1])){"
+    "setStatus('Settings not saved: '+k+' out of range.',true);return;"
+    "}"
+    "params.append(k,String(n));"
+    "}"
+    "}"
+    "setStatus('Saving settings\\u2026');"
+    "fetch('/api/settings',{"
+    "method:'POST',"
+    "headers:{'Content-Type':'application/x-www-form-urlencoded'},"
+    "body:params.toString()"
+    "}).then(function(r){"
+    "if(!r.ok)throw new Error('HTTP '+r.status);"
+    "return r.json();"
+    "}).then(function(d){"
+    "if(populate(d))setStatus('Settings saved.');"
+    "}).catch(function(err){"
+    "setStatus('Settings save failed: '+err.message,true);"
+    "});"
+    "};"
+    "var wire=function(){"
+    "var form=document.getElementById('settings-form');"
+    "if(!form){return;}"
+    "form.addEventListener('submit',submit);"
+    "load();"
+    "};"
+    "if(document.readyState==='loading'){"
+    "document.addEventListener('DOMContentLoaded',wire);"
+    "}else{wire();}"
+    "})();"
+    "</script>"
     "</html>";

