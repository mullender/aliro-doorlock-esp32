+
+// ---- /api/ota ----
+//
+// Trusted-LAN raw firmware upload. The route takes a single
+// application/octet-stream body whose Content-Length equals the
+// declared image size, streams it into the shared OTA transaction
+// core (aliro_local_ota.h) 4 KiB at a time, and on the success
+// path sends a small no-store JSON response, waits briefly for the
+// response to flush, then calls esp_restart. Failure paths NEVER
+// call esp_restart.
+//
+// AliroLocalOtaAbort ownership in this handler:
+//   * HTTP-layer failure while the handler still owns an open core
+//     transaction (early EOF, timeout exhaustion, other recv /
+//     socket error, or the post-loop short-body invariant) -> the
+//     handler calls AliroLocalOtaAbort EXACTLY ONCE before
+//     returning.
+//   * Core-method failure (AliroLocalOtaWrite or
+//     AliroLocalOtaFinish returns != ESP_OK) -> the handler does
+//     NOT call AliroLocalOtaAbort. Those core methods already
+//     consume the transaction and release the shared busy guard;
+//     a second Abort here could race with a fresh Begin from
+//     another caller and abort the new owner's handle.
+esp_err_t ota_post_handler(httpd_req_t * req)
+{
+    // Content-Type must start with application/octet-stream, with
+    // an optional trailing parameter suffix (';' preceded only by
+    // OWS). Anything else, including missing/empty/multipart, is 415.
+    char content_type[64] = { 0 };
+    esp_err_t hdr_err = httpd_req_get_hdr_value_str(req, "Content-Type",
+                                                    content_type, sizeof(content_type));
+    if (hdr_err != ESP_OK)
+    {
+        return send_json_error(req, "415 Unsupported Media Type", "unsupported_content_type");
+    }
+    static const char kExpectedCT[] = "application/octet-stream";
+    const size_t kCtLen = sizeof(kExpectedCT) - 1;
+    if (strncmp(content_type, kExpectedCT, kCtLen) != 0)
+    {
+        return send_json_error(req, "415 Unsupported Media Type", "unsupported_content_type");
+    }
+    const char * tail = content_type + kCtLen;
+    if (*tail != '\0')
+    {
+        while (*tail == ' ' || *tail == '\t') { ++tail; }
+        if (*tail != ';')
+        {
+            return send_json_error(req, "415 Unsupported Media Type", "unsupported_content_type");
+        }
+    }
+
+    // Nonzero Content-Length. content_len is size_t; do NOT narrow.
+    const size_t declared = req->content_len;
+    if (declared == 0)
+    {
+        return send_json_error(req, "400 Bad Request", "empty_body");
+    }
+
+    // Begin the OTA transaction with the declared image size. Map
+    // OTA-core errors to a clear HTTP code. On any Begin failure the
+    // OTA core has already released the busy guard, so DO NOT call
+    // AliroLocalOtaAbort here.
+    esp_err_t bx = AliroLocalOtaBegin(declared);
+    if (bx == ESP_ERR_INVALID_STATE)
+    {
+        return send_json_error(req, "409 Conflict", "busy");
+    }
+    if (bx == ESP_ERR_INVALID_ARG)
+    {
+        return send_json_error(req, "400 Bad Request", "invalid_size");
+    }
+    if (bx == ESP_ERR_INVALID_SIZE)
+    {
+        return send_json_error(req, "413 Payload Too Large", "over_partition");
+    }
+    if (bx == ESP_ERR_NOT_FOUND)
+    {
+        return send_json_error(req, "500 Internal Server Error", "no_ota_partition");
+    }
+    if (bx != ESP_OK)
+    {
+        return send_json_error(req, "500 Internal Server Error", "begin_failed");
+    }
+
+    // From here the handler owns an open core transaction. Ownership
+    // rules for AliroLocalOtaAbort in this handler:
+    //   * HTTP-layer failure while the transaction is still open
+    //     (early EOF, timeout exhaustion, recv/socket error, or the
+    //     post-loop short-body invariant) -> the handler calls
+    //     AliroLocalOtaAbort exactly once before returning.
+    //   * Core-method failure (AliroLocalOtaWrite or
+    //     AliroLocalOtaFinish returns != ESP_OK) -> the handler does
+    //     NOT call AliroLocalOtaAbort. Those core methods already
+    //     consume the transaction and release the shared busy
+    //     guard. A second Abort here could race with a fresh
+    //     Begin from another caller and abort the new owner's
+    //     handle.
+    constexpr size_t kChunkBytes = 4096;
+    static_assert(kChunkBytes == 4096, "raw OTA read buffer must be exactly 4 KiB");
+    char chunk[kChunkBytes];
+    size_t total_read = 0;
+    int retries = 0;
+    constexpr int kMaxRecvRetries = 8;
+    while (total_read < declared)
+    {
+        size_t want = declared - total_read;
+        if (want > kChunkBytes) { want = kChunkBytes; }
+        int n = httpd_req_recv(req, chunk, want);
+        if (n > 0)
+        {
+            esp_err_t wr = AliroLocalOtaWrite(chunk, static_cast<size_t>(n));
+            if (wr != ESP_OK)
+            {
+                // Write already consumed the transaction and
+                // released the busy guard. Do NOT call
+                // AliroLocalOtaAbort here — a second Abort could
+                // race with a fresh Begin from another caller.
+                if (wr == ESP_ERR_INVALID_ARG)
+                {
+                    return send_json_error(req, "400 Bad Request", "invalid_image");
+                }
+                if (wr == ESP_ERR_INVALID_SIZE)
+                {
+                    return send_json_error(req, "400 Bad Request", "size_mismatch");
+                }
+                return send_json_error(req, "500 Internal Server Error", "write_failed");
+            }
+            total_read += static_cast<size_t>(n);
+            retries = 0;
+            continue;
+        }
+        // Cap retries so a stalled peer cannot loop the httpd task.
+        if (n == HTTPD_SOCK_ERR_TIMEOUT && retries++ < kMaxRecvRetries)
+        {
+            continue;
+        }
+        AliroLocalOtaAbort();
+        if (n == HTTPD_SOCK_ERR_TIMEOUT)
+        {
+            return send_json_error(req, "408 Request Timeout", "recv_timeout");
+        }
+        // n == 0 means the peer closed the connection cleanly
+        // before Content-Length was reached. Report that as an
+        // explicit short_body 400 (the exact-count contract is
+        // violated); n < 0 with anything other than TIMEOUT is a
+        // real socket / read error.
+        if (n == 0)
+        {
+            return send_json_error(req, "400 Bad Request", "short_body");
+        }
+        return send_json_error(req, "400 Bad Request", "recv_failed");
+    }
+    // The exact-count check is redundant with Write's overflow-safe
+    // guard but keeps the handler contract explicit.
+    if (total_read != declared)
+    {
+        AliroLocalOtaAbort();
+        return send_json_error(req, "400 Bad Request", "short_body");
+    }
+
+    // Complete the transaction. Finish already consumed the
+    // transaction and released the busy guard by the time it
+    // returns, whether success or error. Do NOT call
+    // AliroLocalOtaAbort here — a second Abort could race with a
+    // fresh Begin from another caller.
+    esp_err_t fx = AliroLocalOtaFinish();
+    if (fx != ESP_OK)
+    {
+        if (fx == ESP_ERR_INVALID_SIZE)
+        {
+            return send_json_error(req, "400 Bad Request", "size_mismatch");
+        }
+        if (fx == ESP_ERR_INVALID_STATE)
+        {
+            return send_json_error(req, "400 Bad Request", "invalid_state");
+        }
+        return send_json_error(req, "500 Internal Server Error", "finish_failed");
+    }
+
+    // Success. Send a small no-store JSON. Only if the response
+    // actually flushed (httpd_resp_send returned ESP_OK) do we wait
+    // for the socket to drain and reboot. If the send itself failed,
+    // return the send error and DO NOT restart — the peer never
+    // observed a success response, and restarting silently would
+    // leave the caller unable to distinguish success from failure.
+    static const char kOkBody[] = "{\"ok\":true,\"restarting\":true}";
+    httpd_resp_set_status(req, "200 OK");
+    httpd_resp_set_type(req, "application/json");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+    esp_err_t send_err = httpd_resp_send(req, kOkBody, sizeof(kOkBody) - 1);
+    if (send_err != ESP_OK)
+    {
+        return send_err;
+    }
+    vTaskDelay(pdMS_TO_TICKS(200));
+    esp_restart();
+    // esp_restart never returns. The trailing return keeps the
+    // compiler happy in the theoretical case that it did.
+    return ESP_OK;
 }

