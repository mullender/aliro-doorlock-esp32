+bool g_aliro_ecp_enabled = false;
+portMUX_TYPE g_aliro_ecp_lock = portMUX_INITIALIZER_UNLOCKED;
+
+bool send_aliro_ecp()
+{
+    std::array<uint8_t, 16> frame = {};
+    bool enabled = false;
+    portENTER_CRITICAL(&g_aliro_ecp_lock);
+    frame = g_aliro_ecp_frame;
+    enabled = g_aliro_ecp_enabled;
+    portEXIT_CRITICAL(&g_aliro_ecp_lock);
+    if (!enabled) {
+        return false;
+    }
+
+    uint8_t response = 0;
+    uint16_t response_len = sizeof(response);
+    // NFCLayerA appends CRC-A. Aliro ECP supplies the 16 bytes before that CRC.
+    (void)g_nfca.transceive(&response, response_len, frame.data(), frame.size(), kEcpResponseTimeoutMs);
+    return true;
+}
