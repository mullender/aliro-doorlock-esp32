+    if (!DoorLock::DoorLockServer::Instance().GetAutoRelockTime(door_lock_endpoint_id, auto_relock_seconds)) {
+        ESP_LOGW("Aliro", "Could not read the auto-lock time after a valid tap");
+        return;
+    }
+    if (auto_relock_seconds != 0) {
+        BoltLockMgr().Unlock(door_lock_endpoint_id, DoorLock::OperationSourceEnum::kAliro);
+        return;
+    }
+
+    BoltLockMgr().Lock(door_lock_endpoint_id, DoorLock::OperationSourceEnum::kAliro);
