+/*
+   Trusted-LAN HTTP foundation for the Wi-Fi variants of the Aliro
+   door-lock reader firmware.
+
+   The interface is intentionally minimal: bind one esp_event handler
+   to the Matter Wi-Fi station lifecycle and start / stop a native
+   esp_http_server accordingly. This header is only present in Wi-Fi
+   variants; the Thread variant never sees or links to it.
+*/
+
+#pragma once
+
+#include <esp_err.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+   Register the HTTP server's start / stop callbacks against the Matter
+   Wi-Fi station lifecycle.
+
+   Start:  IP_EVENT_STA_GOT_IP           (server up on port 80).
+   Stop:   IP_EVENT_STA_LOST_IP          (assigned IP is gone).
+           WIFI_EVENT_STA_DISCONNECTED   (link is down).
+
+   Return non-ESP_OK if the esp_event handler could not be registered;
+   the caller must treat that as non-fatal to Matter and Aliro.
+*/
+esp_err_t aliro_local_web_bind_wifi_lifecycle(void);
+
+#ifdef __cplusplus
+}
+#endif
