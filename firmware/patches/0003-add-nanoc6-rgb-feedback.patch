+class ScopedSemaphoreLock {
+public:
+    explicit ScopedSemaphoreLock(SemaphoreHandle_t semaphore) : m_semaphore(semaphore)
+    {
+        m_locked = m_semaphore && xSemaphoreTake(m_semaphore, portMAX_DELAY) == pdTRUE;
+    }
+
+    ~ScopedSemaphoreLock()
+    {
+        if (m_locked) {
+            (void)xSemaphoreGive(m_semaphore);
+        }
+    }
+
+    ScopedSemaphoreLock(const ScopedSemaphoreLock &) = delete;
+    ScopedSemaphoreLock &operator=(const ScopedSemaphoreLock &) = delete;
+
+    bool IsLocked() const { return m_locked; }
+
+private:
+    SemaphoreHandle_t m_semaphore;
+    bool m_locked = false;
+};
+
+bool BytesEqual(const uint8_t *left, const uint8_t *right, size_t length)
+{
+    for (size_t index = 0; index < length; ++index) {
+        if (left[index] != right[index]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool IsAliroSelectCommand(const uint8_t *command, size_t command_len)
+{
+    const size_t prefix_len = sizeof(kSelectHeader) + sizeof(kAliroExpeditedAid);
+    return command && command_len >= prefix_len && BytesEqual(command, kSelectHeader, sizeof(kSelectHeader)) &&
+        BytesEqual(command + sizeof(kSelectHeader), kAliroExpeditedAid, sizeof(kAliroExpeditedAid));
+}
+
+bool IsSuccessfulAliroSelectResponse(const uint8_t *response, size_t response_len)
+{
+    constexpr size_t status_len = 2;
+    constexpr size_t fci_header_len = 2;
+    constexpr size_t aid_tlv_header_len = 2;
+    if (!response || response_len < status_len || response[response_len - 2] != 0x90 ||
+        response[response_len - 1] != 0x00) {
+        return false;
+    }
+    const size_t fci_len = response_len - status_len;
+    if (fci_len < fci_header_len + aid_tlv_header_len + sizeof(kAliroExpeditedAid) ||
+        response[0] != kFciTemplateTag || response[1] != fci_len - fci_header_len) {
+        return false;
+    }
+    const size_t aid_offset = fci_header_len + aid_tlv_header_len;
+    if (response[fci_header_len] != kDedicatedFileNameTag ||
+        response[fci_header_len + 1] != sizeof(kAliroExpeditedAid) ||
+        aid_offset + sizeof(kAliroExpeditedAid) > fci_len) {
+        return false;
+    }
+    return BytesEqual(response + aid_offset, kAliroExpeditedAid, sizeof(kAliroExpeditedAid));
+}
+
+esp_err_t SetStatusLedColor(StatusLedResult result)
+{
+    uint8_t red = 0;
+    uint8_t green = 0;
+    uint8_t blue = 0;
+    switch (result) {
+    case StatusLedResult::kSuccess:
+        green = kStatusLedBrightness;
+        break;
+    case StatusLedResult::kFailure:
+        red = kStatusLedBrightness;
+        break;
+    case StatusLedResult::kOtherTag:
+        blue = kStatusLedBrightness;
+        break;
+    }
+    ESP_RETURN_ON_ERROR(led_strip_set_pixel(g_status_led, 0, red, green, blue), "Aliro",
+                        "Failed to set NanoC6 RGB LED");
+    return led_strip_refresh(g_status_led);
+}
+
+void StatusLedTask(void *)
+{
+    esp_err_t err = led_strip_clear(g_status_led);
+    if (err != ESP_OK) {
+        ESP_LOGW("Aliro", "Failed to clear NanoC6 RGB LED: %s", esp_err_to_name(err));
+    }
+
+    StatusLedResult result;
+    while (true) {
+        if (xQueueReceive(g_status_led_queue, &result, portMAX_DELAY) != pdTRUE) {
+            continue;
+        }
+        while (true) {
+            err = SetStatusLedColor(result);
+            if (err != ESP_OK) {
+                ESP_LOGW("Aliro", "Failed to update NanoC6 RGB LED: %s", esp_err_to_name(err));
+            }
+
+            StatusLedResult next_result;
+            if (xQueueReceive(g_status_led_queue, &next_result, pdMS_TO_TICKS(kStatusLedDurationMs)) == pdTRUE) {
+                result = next_result;
+                continue;
+            }
+            err = led_strip_clear(g_status_led);
+            if (err != ESP_OK) {
+                ESP_LOGW("Aliro", "Failed to clear NanoC6 RGB LED: %s", esp_err_to_name(err));
+            }
+            break;
+        }
+    }
+}
+
+void CleanupStatusLed()
+{
+    if (g_status_led_queue) {
+        vQueueDelete(g_status_led_queue);
+        g_status_led_queue = nullptr;
+    }
+    if (g_status_led) {
+        (void)led_strip_del(g_status_led);
+        g_status_led = nullptr;
+    }
+    (void)gpio_set_level(kStatusLedPowerPin, 0);
+}
-
+
+esp_err_t InitStatusLed()
+{
+    gpio_config_t power_config = {};
+    power_config.pin_bit_mask = 1ULL << kStatusLedPowerPin;
+    power_config.mode = GPIO_MODE_OUTPUT;
+    power_config.pull_up_en = GPIO_PULLUP_DISABLE;
+    power_config.pull_down_en = GPIO_PULLDOWN_DISABLE;
+    power_config.intr_type = GPIO_INTR_DISABLE;
+    esp_err_t err = gpio_config(&power_config);
+    if (err != ESP_OK) {
+        return err;
+    }
+    err = gpio_set_level(kStatusLedPowerPin, 1);
+    if (err != ESP_OK) {
+        return err;
+    }
+
+    led_strip_config_t strip_config = {};
+    strip_config.strip_gpio_num = kStatusLedDataPin;
+    strip_config.max_leds = 1;
+    strip_config.led_pixel_format = LED_PIXEL_FORMAT_GRB;
+    strip_config.led_model = LED_MODEL_WS2812;
+    strip_config.flags.invert_out = false;
+    led_strip_rmt_config_t rmt_config = {};
+    rmt_config.clk_src = RMT_CLK_SRC_DEFAULT;
+    rmt_config.resolution_hz = 10 * 1000 * 1000;
+    rmt_config.mem_block_symbols = 0;
+    rmt_config.flags.with_dma = false;
+    err = led_strip_new_rmt_device(&strip_config, &rmt_config, &g_status_led);
+    if (err != ESP_OK) {
+        (void)gpio_set_level(kStatusLedPowerPin, 0);
+        return err;
+    }
+
+    g_status_led_queue = xQueueCreate(1, sizeof(StatusLedResult));
+    if (!g_status_led_queue) {
+        CleanupStatusLed();
+        return ESP_ERR_NO_MEM;
+    }
+    if (xTaskCreate(StatusLedTask, "aliro_led", kStatusLedTaskStackSize, nullptr, kStatusLedTaskPriority,
+                    &g_status_led_task) != pdPASS) {
+        CleanupStatusLed();
+        return ESP_ERR_NO_MEM;
+    }
+    ESP_LOGI("Aliro", "NanoC6 RGB status LED initialized on GPIO %d (power GPIO %d)", kStatusLedDataPin,
+             kStatusLedPowerPin);
+    return ESP_OK;
+}
+
+void ShowStatusLed(StatusLedResult result)
+{
+    if (!g_status_led_queue) {
+        return;
+    }
+    (void)xQueueOverwrite(g_status_led_queue, &result);
+}
