+constexpr gpio_num_t kStatusLedPowerPin = GPIO_NUM_19;
+constexpr gpio_num_t kStatusLedDataPin = GPIO_NUM_20;
+constexpr uint32_t kStatusLedDurationMs = 1000;
+constexpr uint32_t kStatusLedTaskStackSize = 3072;
+constexpr UBaseType_t kStatusLedTaskPriority = 3;
+constexpr uint8_t kStatusLedBrightness = 255;
+constexpr uint8_t kSelectHeader[] = { 0x00, 0xA4, 0x04, 0x00, 0x09 };
+constexpr uint8_t kAliroExpeditedAid[] = { 0xA0, 0x00, 0x00, 0x09, 0x09, 0xAC, 0xCE, 0x55, 0x01 };
+constexpr uint8_t kFciTemplateTag = 0x6F;
+constexpr uint8_t kDedicatedFileNameTag = 0x84;
+
+enum class StatusLedResult {
+    kSuccess,
+    kFailure,
+    kOtherTag,
+};
+
+led_strip_handle_t g_status_led = nullptr;
+QueueHandle_t g_status_led_queue = nullptr;
+TaskHandle_t g_status_led_task = nullptr;
+SemaphoreHandle_t g_aliro_reader_mutex = nullptr;
