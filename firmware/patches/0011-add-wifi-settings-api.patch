+// ---- /api/settings ----
+
+// Emit the seven settings values as a compact JSON object with RGB
+// values as six lowercase hex characters. Both GET and successful
+// POST paths reuse this to return the authoritative current state.
+esp_err_t emit_settings_json(httpd_req_t * req, const AliroSettingsSnapshot & s)
+{
+    char body[256];
+    int n = snprintf(body, sizeof(body),
+        "{\"auto_relock_seconds\":%u,"
+        "\"success_rgb\":\"%06x\",\"success_ms\":%u,"
+        "\"failure_rgb\":\"%06x\",\"failure_ms\":%u,"
+        "\"other_rgb\":\"%06x\",\"other_ms\":%u}",
+        static_cast<unsigned>(s.auto_relock_seconds),
+        static_cast<unsigned>(s.success_rgb), static_cast<unsigned>(s.success_ms),
+        static_cast<unsigned>(s.failure_rgb), static_cast<unsigned>(s.failure_ms),
+        static_cast<unsigned>(s.other_rgb),   static_cast<unsigned>(s.other_ms));
+    if (n < 0 || static_cast<size_t>(n) >= sizeof(body))
+    {
+        return httpd_resp_send_err(req, HTTPD_500_INTERNAL_SERVER_ERROR, "internal");
+    }
+    httpd_resp_set_type(req, "application/json");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+    return httpd_resp_send(req, body, n);
+}
+
+// Compose a JSON error body under a caller-supplied HTTP status line.
+// Uses literal status strings (esp_http_server's httpd_err_code_t
+// enum has no 415 value in ESP-IDF v5.5, so we never route through
+// httpd_resp_send_err for the media-type case).
+esp_err_t send_json_error(httpd_req_t * req, const char * status_line, const char * code)
+{
+    char body[96];
+    int n = snprintf(body, sizeof(body), "{\"error\":\"%s\"}", code);
+    if (n < 0 || static_cast<size_t>(n) >= sizeof(body)) n = 0;
+    httpd_resp_set_status(req, status_line);
+    httpd_resp_set_type(req, "application/json");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+    return httpd_resp_send(req, body, n);
+}
+
+esp_err_t settings_get_handler(httpd_req_t * req)
+{
+    return emit_settings_json(req, AliroSettingsGet());
+}
+
+esp_err_t settings_post_handler(httpd_req_t * req)
+{
+    // Bounded body. 256 bytes easily fits every legal 7-key SET line
+    // (about 145 chars fully specified) with no room for pathological
+    // padding. Anything larger is refused outright.
+    constexpr size_t kMaxBodyBytes = 256;
+
+    // Content-Type must be application/x-www-form-urlencoded, with
+    // an optional trailing charset/parameter suffix. Anything else,
+    // including missing / empty / multipart, is 415.
+    char content_type[64] = { 0 };
+    esp_err_t hdr_err = httpd_req_get_hdr_value_str(req, "Content-Type",
+                                                    content_type, sizeof(content_type));
+    if (hdr_err != ESP_OK)
+    {
+        return send_json_error(req, "415 Unsupported Media Type", "unsupported_content_type");
+    }
+    static const char kExpectedCT[] = "application/x-www-form-urlencoded";
+    const size_t kCtLen = sizeof(kExpectedCT) - 1;
+    if (strncmp(content_type, kExpectedCT, kCtLen) != 0 ||
+        (content_type[kCtLen] != '\0' && content_type[kCtLen] != ';' &&
+         content_type[kCtLen] != ' '))
+    {
+        return send_json_error(req, "415 Unsupported Media Type", "unsupported_content_type");
+    }
+
+    // Body length checks. httpd_req_t::content_len is size_t; do NOT
+    // narrow to int, because a very large declared length would wrap
+    // to a negative int before the over-limit check runs.
+    const size_t declared = req->content_len;
+    if (declared == 0)
+    {
+        return send_json_error(req, "400 Bad Request", "bad_request");
+    }
+    if (declared > kMaxBodyBytes)
+    {
+        return send_json_error(req, "413 Payload Too Large", "over_limit");
+    }
+
+    // Bounded read with retries for short reads / timeouts. Cap the
+    // retry count so a stalled peer cannot loop the httpd task.
+    char body[kMaxBodyBytes + 1] = { 0 };
+    size_t total_read = 0;
+    int retries = 0;
+    constexpr int kMaxRecvRetries = 8;
+    while (total_read < declared)
+    {
+        int n = httpd_req_recv(req, body + total_read,
+                               declared - total_read);
+        if (n > 0)
+        {
+            total_read += static_cast<size_t>(n);
+            continue;
+        }
+        if (n == HTTPD_SOCK_ERR_TIMEOUT && retries++ < kMaxRecvRetries)
+        {
+            continue;
+        }
+        if (n == HTTPD_SOCK_ERR_TIMEOUT)
+        {
+            return send_json_error(req, "408 Request Timeout", "recv_timeout");
+        }
+        return send_json_error(req, "400 Bad Request", "recv_failed");
+    }
+    body[total_read] = '\0';
+
+    // Strict allowlist: key chars, '=' as key/value separator, '&'
+    // between pairs. Rejects percent-escapes, '+' (form space),
+    // whitespace, control bytes, and anything else. Our keys and
+    // values (decimals + six-char RGB) never require any escape.
+    for (size_t i = 0; i < total_read; ++i)
+    {
+        char c = body[i];
+        bool ok = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+                  (c >= '0' && c <= '9') || c == '_' || c == '=' || c == '&';
+        if (!ok)
+        {
+            return send_json_error(req, "400 Bad Request", "bad_request");
+        }
+    }
+
+    // Rewrite into the existing "ALIRO/1 SET k=v ..." protocol line
+    // and hand it to AliroSettingsSerializedSetApply, which re-reads
+    // the current snapshot AND applies the resulting candidate under
+    // one apply mutex. The serial protocol takes the same path, so
+    // a concurrent serial and HTTP partial-apply cannot lose either
+    // request's updates.
+    static const char kPrefix[] = "ALIRO/1 SET ";
+    const size_t kPrefixLen = sizeof(kPrefix) - 1;
+    char line[kPrefixLen + kMaxBodyBytes + 1];
+    memcpy(line, kPrefix, kPrefixLen);
+    memcpy(line + kPrefixLen, body, total_read);
+    line[kPrefixLen + total_read] = '\0';
+    for (size_t i = kPrefixLen; i < kPrefixLen + total_read; ++i)
+    {
+        if (line[i] == '&') line[i] = ' ';
+    }
+
+    AliroSettingsApplyOutcome outcome = AliroSettingsSerializedSetApply(line);
+    switch (outcome)
+    {
+    case AliroSettingsApplyOutcome::kOk:
+        return emit_settings_json(req, AliroSettingsGet());
+    case AliroSettingsApplyOutcome::kBadRequest:
+        return send_json_error(req, "400 Bad Request", "bad_request");
+    case AliroSettingsApplyOutcome::kUnknownKey:
+        return send_json_error(req, "400 Bad Request", "unknown_key");
+    case AliroSettingsApplyOutcome::kInvalidValue:
+        return send_json_error(req, "400 Bad Request", "invalid_value");
+    case AliroSettingsApplyOutcome::kStorage:
+        return send_json_error(req, "500 Internal Server Error", "storage");
+    case AliroSettingsApplyOutcome::kMatter:
+        return send_json_error(req, "500 Internal Server Error", "matter");
+    case AliroSettingsApplyOutcome::kBusy:
+    default:
+        return send_json_error(req, "500 Internal Server Error", "busy");
+    }
 }

