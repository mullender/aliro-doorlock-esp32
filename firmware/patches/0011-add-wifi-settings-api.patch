+// Outcome of a serialized set-apply attempt. Parser rejections and
+// runtime failures share one enum so callers (serial protocol, local
+// Wi-Fi HTTP API) can map each case to their own error format.
+enum class AliroSettingsApplyOutcome : uint8_t {
+    kOk,
+    kBadRequest,     // parser: malformed input, empty request, duplicate key
+    kUnknownKey,     // parser: key outside the seven known settings
+    kInvalidValue,   // parser: value fails the shared range or hex check
+    kStorage,        // NVS write / rollback failure
+    kMatter,         // Matter attribute-update failure
+    kBusy,           // internal state not ready (mutex missing)
+};
+
+// The single settings-apply entry point shared by the serial "ALIRO/1
+// SET" protocol handler and the local HTTP POST /api/settings
+// handler. Takes an internal apply mutex, re-reads current settings
+// UNDER the mutex, hands the mutable `set_line` (which must already
+// have the "ALIRO/1 SET " prefix) to AliroParseRequest, then applies
+// the resulting candidate. This keeps the read-current + parse +
+// apply sequence one serialized transaction so a concurrent partial
+// apply cannot land based on a stale snapshot.
+AliroSettingsApplyOutcome AliroSettingsSerializedSetApply(char *set_line);
