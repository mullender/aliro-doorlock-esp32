+AliroSettingsApplyOutcome AliroSettingsSerializedSetApply(char *set_line)
+{
+    if (!g_apply_mutex) {
+        return AliroSettingsApplyOutcome::kBusy;
+    }
+    if (xSemaphoreTake(g_apply_mutex, portMAX_DELAY) != pdTRUE) {
+        return AliroSettingsApplyOutcome::kBusy;
+    }
+
+    // Re-read current settings UNDER the apply mutex so a concurrent
+    // partial-apply cannot land based on a stale snapshot: the read,
+    // parse, and apply below run as one serialized transaction.
+    const AliroSettingsSnapshot current = AliroSettingsGet();
+
+    AliroParsedRequest request;
+    AliroParseError parse_error = AliroParseRequest(set_line, current, request);
+    if (parse_error != AliroParseError::kNone) {
+        (void)xSemaphoreGive(g_apply_mutex);
+        switch (parse_error) {
+        case AliroParseError::kUnknownKey:   return AliroSettingsApplyOutcome::kUnknownKey;
+        case AliroParseError::kInvalidValue: return AliroSettingsApplyOutcome::kInvalidValue;
+        case AliroParseError::kBadRequest:
+        default:                             return AliroSettingsApplyOutcome::kBadRequest;
+        }
+    }
+    if (request.kind != AliroRequestKind::kSet) {
+        // Callers must pass an "ALIRO/1 SET ..." line; a GET here is
+        // a caller bug, not a client input error.
+        (void)xSemaphoreGive(g_apply_mutex);
+        return AliroSettingsApplyOutcome::kBadRequest;
+    }
+
+    bool storage_error = true;
+    esp_err_t error = ApplySettings(request.settings, storage_error);
+    (void)xSemaphoreGive(g_apply_mutex);
+    if (error == ESP_OK) {
+        return AliroSettingsApplyOutcome::kOk;
+    }
+    // Preserve the detailed ESP_LOGE so console debugging keeps the
+    // original esp_err_to_name(error) context regardless of which
+    // caller (serial or HTTP) triggered the failure.
+    ESP_LOGE(kTag, "Could not apply settings (%s): %s",
+             storage_error ? "storage" : "matter", esp_err_to_name(error));
+    return storage_error ? AliroSettingsApplyOutcome::kStorage : AliroSettingsApplyOutcome::kMatter;
+}
