diff --git a/examples/door_lock/main/aliro_settings.cpp b/examples/door_lock/main/aliro_settings.cpp
new file mode 100644
index 0000000..d548556
--- /dev/null
+++ b/examples/door_lock/main/aliro_settings.cpp
@@ -0,0 +1,256 @@
+#include "aliro_settings.h"
+
+#include <esp_app_desc.h>
+#include <esp_log.h>
+#include <esp_matter.h>
+#include <freertos/FreeRTOS.h>
+#include <freertos/semphr.h>
+#include <freertos/task.h>
+#include <inttypes.h>
+#include <nvs.h>
+#include <stdio.h>
+#include <string.h>
+
+using namespace chip::app::Clusters;
+
+namespace {
+
+constexpr char kTag[] = "aliro_settings";
+constexpr char kNvsNamespace[] = "aliro_settings";
+constexpr char kNvsKey[] = "config";
+constexpr uint32_t kSettingsSchemaVersion = 1;
+constexpr size_t kSerialLineSize = 256;
+constexpr uint32_t kSerialTaskStackSize = 4096;
+constexpr UBaseType_t kSerialTaskPriority = 2;
+
+struct PersistedSettings {
+    uint32_t schema_version;
+    AliroSettingsSnapshot settings;
+};
+
+static_assert(sizeof(PersistedSettings) == 8 * sizeof(uint32_t));
+
+SemaphoreHandle_t g_settings_mutex = nullptr;
+AliroSettingsSnapshot g_settings = kAliroDefaultSettings;
+uint16_t g_door_lock_endpoint_id = 0;
+
+bool SettingsAreValid(const AliroSettingsSnapshot &settings)
+{
+    return settings.auto_relock_seconds <= 3600 && settings.success_rgb <= 0xFFFFFF &&
+        settings.failure_rgb <= 0xFFFFFF && settings.other_rgb <= 0xFFFFFF && settings.success_ms <= 10000 &&
+        settings.failure_ms <= 10000 && settings.other_ms <= 10000;
+}
+
+esp_err_t StoreSettings(const AliroSettingsSnapshot &settings)
+{
+    nvs_handle_t handle;
+    esp_err_t error = nvs_open(kNvsNamespace, NVS_READWRITE, &handle);
+    if (error != ESP_OK) {
+        return error;
+    }
+
+    const PersistedSettings persisted = {
+        .schema_version = kSettingsSchemaVersion,
+        .settings = settings,
+    };
+    error = nvs_set_blob(handle, kNvsKey, &persisted, sizeof(persisted));
+    if (error == ESP_OK) {
+        error = nvs_commit(handle);
+    }
+    nvs_close(handle);
+    return error;
+}
+
+esp_err_t LoadSettings(AliroSettingsSnapshot &settings)
+{
+    nvs_handle_t handle;
+    esp_err_t error = nvs_open(kNvsNamespace, NVS_READONLY, &handle);
+    if (error != ESP_OK) {
+        return error;
+    }
+
+    PersistedSettings persisted = {};
+    size_t size = sizeof(persisted);
+    error = nvs_get_blob(handle, kNvsKey, &persisted, &size);
+    nvs_close(handle);
+    if (error != ESP_OK) {
+        return error;
+    }
+    if (size != sizeof(persisted) || persisted.schema_version != kSettingsSchemaVersion ||
+        !SettingsAreValid(persisted.settings)) {
+        return ESP_ERR_INVALID_VERSION;
+    }
+    settings = persisted.settings;
+    return ESP_OK;
+}
+
+void SetCurrentSettings(const AliroSettingsSnapshot &settings)
+{
+    if (xSemaphoreTake(g_settings_mutex, portMAX_DELAY) == pdTRUE) {
+        g_settings = settings;
+        (void)xSemaphoreGive(g_settings_mutex);
+    }
+}
+
+void EmitError(const char *code)
+{
+    printf("ALIRO/1 ERROR code=%s\n", code);
+    fflush(stdout);
+}
+
+void EmitStatus()
+{
+    const AliroSettingsSnapshot settings = AliroSettingsGet();
+    printf("ALIRO/1 STATUS firmware=%s protocol=1 auto_relock_seconds=%" PRIu32
+           " success_rgb=%06" PRIX32 " failure_rgb=%06" PRIX32 " other_rgb=%06" PRIX32
+           " success_ms=%" PRIu32 " failure_ms=%" PRIu32 " other_ms=%" PRIu32 "\n",
+           esp_app_get_description()->version, settings.auto_relock_seconds, settings.success_rgb,
+           settings.failure_rgb, settings.other_rgb,
+           settings.success_ms, settings.failure_ms, settings.other_ms);
+    fflush(stdout);
+}
+
+esp_err_t ApplySettings(const AliroSettingsSnapshot &candidate, bool &storage_error)
+{
+    storage_error = true;
+    const AliroSettingsSnapshot previous = AliroSettingsGet();
+    esp_err_t error = StoreSettings(candidate);
+    if (error != ESP_OK) {
+        return error;
+    }
+
+    if (candidate.auto_relock_seconds != previous.auto_relock_seconds) {
+        storage_error = false;
+        esp_matter_attr_val_t value = esp_matter_uint32(candidate.auto_relock_seconds);
+        error = esp_matter::attribute::update(g_door_lock_endpoint_id, DoorLock::Id,
+                                              DoorLock::Attributes::AutoRelockTime::Id, &value);
+        if (error != ESP_OK) {
+            esp_err_t rollback_error = StoreSettings(previous);
+            if (rollback_error != ESP_OK) {
+                ESP_LOGE(kTag, "Could not restore settings after a Matter attribute error: %s",
+                         esp_err_to_name(rollback_error));
+            }
+            return error;
+        }
+    }
+
+    SetCurrentSettings(candidate);
+    return ESP_OK;
+}
+
+void ProcessLine(char *line)
+{
+    AliroParsedRequest request;
+    AliroParseError parse_error = AliroParseRequest(line, AliroSettingsGet(), request);
+    if (parse_error != AliroParseError::kNone) {
+        EmitError(AliroParseErrorCode(parse_error));
+        return;
+    }
+    if (request.kind == AliroRequestKind::kGet) {
+        EmitStatus();
+        return;
+    }
+
+    bool storage_error;
+    esp_err_t error = ApplySettings(request.settings, storage_error);
+    if (error != ESP_OK) {
+        ESP_LOGE(kTag, "Could not apply settings: %s", esp_err_to_name(error));
+        EmitError(storage_error ? "storage" : "matter");
+        return;
+    }
+    EmitStatus();
+}
+
+void SerialTask(void *)
+{
+    EmitStatus();
+
+    char line[kSerialLineSize];
+    size_t length = 0;
+    bool discard_line = false;
+    bool non_ascii = false;
+    while (true) {
+        const int input = fgetc(stdin);
+        if (input == EOF) {
+            clearerr(stdin);
+            vTaskDelay(pdMS_TO_TICKS(10));
+            continue;
+        }
+        if (input == '\r' || input == '\n') {
+            if (discard_line) {
+                EmitError("line_too_long");
+            } else if (non_ascii) {
+                EmitError("bad_request");
+            } else if (length != 0) {
+                line[length] = '\0';
+                ProcessLine(line);
+            }
+            length = 0;
+            discard_line = false;
+            non_ascii = false;
+            continue;
+        }
+        if (input < 0x20 || input > 0x7E) {
+            non_ascii = true;
+            continue;
+        }
+        if (length + 1 >= sizeof(line)) {
+            discard_line = true;
+            continue;
+        }
+        if (!discard_line) {
+            line[length++] = static_cast<char>(input);
+        }
+    }
+}
+
+} // namespace
+
+esp_err_t AliroSettingsInit()
+{
+    g_settings_mutex = xSemaphoreCreateMutex();
+    if (!g_settings_mutex) {
+        return ESP_ERR_NO_MEM;
+    }
+
+    AliroSettingsSnapshot settings;
+    esp_err_t error = LoadSettings(settings);
+    if (error == ESP_ERR_NVS_NOT_FOUND) {
+        settings = kAliroDefaultSettings;
+        error = StoreSettings(settings);
+    } else if (error != ESP_OK) {
+        ESP_LOGW(kTag, "Stored settings are invalid. Restoring defaults: %s", esp_err_to_name(error));
+        settings = kAliroDefaultSettings;
+        error = StoreSettings(settings);
+    }
+    if (error != ESP_OK) {
+        vSemaphoreDelete(g_settings_mutex);
+        g_settings_mutex = nullptr;
+        return error;
+    }
+
+    SetCurrentSettings(settings);
+    return ESP_OK;
+}
+
+AliroSettingsSnapshot AliroSettingsGet()
+{
+    AliroSettingsSnapshot settings = kAliroDefaultSettings;
+    if (g_settings_mutex && xSemaphoreTake(g_settings_mutex, portMAX_DELAY) == pdTRUE) {
+        settings = g_settings;
+        (void)xSemaphoreGive(g_settings_mutex);
+    }
+    return settings;
+}
+
+esp_err_t AliroSettingsStartSerial(uint16_t door_lock_endpoint_id)
+{
+    if (!g_settings_mutex || door_lock_endpoint_id == 0) {
+        return ESP_ERR_INVALID_STATE;
+    }
+    g_door_lock_endpoint_id = door_lock_endpoint_id;
+    if (xTaskCreate(SerialTask, "aliro_serial", kSerialTaskStackSize, nullptr, kSerialTaskPriority, nullptr) != pdPASS) {
+        return ESP_ERR_NO_MEM;
+    }
+    return ESP_OK;
+}
