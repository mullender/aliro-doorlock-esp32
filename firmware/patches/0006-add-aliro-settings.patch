index 0000000..75ec0da
--- /dev/null
+++ b/examples/door_lock/main/aliro_settings_protocol.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <stdint.h>
+
+struct AliroSettingsSnapshot {
+    uint32_t auto_relock_seconds;
+    uint32_t success_rgb;
+    uint32_t failure_rgb;
+    uint32_t other_rgb;
+    uint32_t success_ms;
+    uint32_t failure_ms;
+    uint32_t other_ms;
+};
+
+constexpr AliroSettingsSnapshot kAliroDefaultSettings = {
+    .auto_relock_seconds = 5,
+    .success_rgb = 0x00FF00,
+    .failure_rgb = 0xFF0000,
+    .other_rgb = 0x0000FF,
+    .success_ms = 1000,
+    .failure_ms = 1000,
+    .other_ms = 1000,
+};
+
+enum class AliroRequestKind {
+    kGet,
+    kSet,
+};
+
+enum class AliroParseError {
+    kNone,
+    kBadRequest,
+    kUnknownKey,
+    kInvalidValue,
+};
+
+struct AliroParsedRequest {
+    AliroRequestKind kind;
+    AliroSettingsSnapshot settings;
+};
+
+AliroParseError AliroParseRequest(char *line, const AliroSettingsSnapshot &current, AliroParsedRequest &request);
+const char *AliroParseErrorCode(AliroParseError error);
diff --git a/examples/door_lock/main/aliro_settings_protocol.cpp b/examples/door_lock/main/aliro_settings_protocol.cpp
new file mode 100644
index 0000000..4cab7c8
--- /dev/null
+++ b/examples/door_lock/main/aliro_settings_protocol.cpp
@@ -0,0 +1,176 @@
+#include "aliro_settings_protocol.h"
+
+#include <stddef.h>
+#include <string.h>
+
+namespace {
+
+constexpr char kGetRequest[] = "ALIRO/1 GET";
+constexpr char kSetPrefix[] = "ALIRO/1 SET ";
+
+bool ParseDecimal(const char *text, uint32_t maximum, uint32_t &value)
+{
+    if (!text || !text[0]) {
+        return false;
+    }
+
+    uint32_t parsed = 0;
+    for (const char *cursor = text; *cursor; ++cursor) {
+        if (*cursor < '0' || *cursor > '9') {
+            return false;
+        }
+        const uint32_t digit = static_cast<uint32_t>(*cursor - '0');
+        if (parsed > (maximum - digit) / 10) {
+            return false;
+        }
+        parsed = parsed * 10 + digit;
+    }
+    value = parsed;
+    return true;
+}
+
+bool ParseRgb(const char *text, uint32_t &value)
+{
+    if (!text || strlen(text) != 6) {
+        return false;
+    }
+
+    uint32_t parsed = 0;
+    for (size_t index = 0; index < 6; ++index) {
+        const char character = text[index];
+        uint32_t digit;
+        if (character >= '0' && character <= '9') {
+            digit = static_cast<uint32_t>(character - '0');
+        } else if (character >= 'A' && character <= 'F') {
+            digit = static_cast<uint32_t>(character - 'A' + 10);
+        } else if (character >= 'a' && character <= 'f') {
+            digit = static_cast<uint32_t>(character - 'a' + 10);
+        } else {
+            return false;
+        }
+        parsed = (parsed << 4) | digit;
+    }
+    value = parsed;
+    return true;
+}
+
+AliroParseError ParseSetting(char *token, AliroSettingsSnapshot &settings, uint32_t &seen_keys)
+{
+    char *equals = strchr(token, '=');
+    if (!equals || equals == token || !equals[1] || strchr(equals + 1, '=')) {
+        return AliroParseError::kBadRequest;
+    }
+    *equals = '\0';
+    const char *key = token;
+    const char *value = equals + 1;
+
+    uint32_t key_bit;
+    uint32_t *target;
+    uint32_t maximum;
+    bool is_rgb = false;
+    if (strcmp(key, "auto_relock_seconds") == 0) {
+        key_bit = 1U << 0;
+        target = &settings.auto_relock_seconds;
+        maximum = 3600;
+    } else if (strcmp(key, "success_rgb") == 0) {
+        key_bit = 1U << 1;
+        target = &settings.success_rgb;
+        maximum = 0xFFFFFF;
+        is_rgb = true;
+    } else if (strcmp(key, "failure_rgb") == 0) {
+        key_bit = 1U << 2;
+        target = &settings.failure_rgb;
+        maximum = 0xFFFFFF;
+        is_rgb = true;
+    } else if (strcmp(key, "other_rgb") == 0) {
+        key_bit = 1U << 3;
+        target = &settings.other_rgb;
+        maximum = 0xFFFFFF;
+        is_rgb = true;
+    } else if (strcmp(key, "success_ms") == 0) {
+        key_bit = 1U << 4;
+        target = &settings.success_ms;
+        maximum = 10000;
+    } else if (strcmp(key, "failure_ms") == 0) {
+        key_bit = 1U << 5;
+        target = &settings.failure_ms;
+        maximum = 10000;
+    } else if (strcmp(key, "other_ms") == 0) {
+        key_bit = 1U << 6;
+        target = &settings.other_ms;
+        maximum = 10000;
+    } else {
+        return AliroParseError::kUnknownKey;
+    }
+
+    if ((seen_keys & key_bit) != 0) {
+        return AliroParseError::kBadRequest;
+    }
+    seen_keys |= key_bit;
+
+    uint32_t parsed;
+    if (!(is_rgb ? ParseRgb(value, parsed) : ParseDecimal(value, maximum, parsed))) {
+        return AliroParseError::kInvalidValue;
+    }
+    *target = parsed;
+    return AliroParseError::kNone;
+}
+
+} // namespace
+
+AliroParseError AliroParseRequest(char *line, const AliroSettingsSnapshot &current, AliroParsedRequest &request)
+{
+    if (!line) {
+        return AliroParseError::kBadRequest;
+    }
+    if (strcmp(line, kGetRequest) == 0) {
+        request = { .kind = AliroRequestKind::kGet, .settings = current };
+        return AliroParseError::kNone;
+    }
+    if (strncmp(line, kSetPrefix, sizeof(kSetPrefix) - 1) != 0) {
+        return AliroParseError::kBadRequest;
+    }
+
+    AliroSettingsSnapshot candidate = current;
+    uint32_t seen_keys = 0;
+    char *cursor = line + sizeof(kSetPrefix) - 1;
+    while (*cursor) {
+        char *token = cursor;
+        char *separator = strchr(cursor, ' ');
+        if (separator) {
+            if (separator == token || !separator[1]) {
+                return AliroParseError::kBadRequest;
+            }
+            *separator = '\0';
+            cursor = separator + 1;
+        } else {
+            cursor += strlen(cursor);
+        }
+
+        AliroParseError error = ParseSetting(token, candidate, seen_keys);
+        if (error != AliroParseError::kNone) {
+            return error;
+        }
+    }
+    if (seen_keys == 0) {
+        return AliroParseError::kBadRequest;
+    }
+
+    request = { .kind = AliroRequestKind::kSet, .settings = candidate };
+    return AliroParseError::kNone;
+}
+
+const char *AliroParseErrorCode(AliroParseError error)
+{
+    switch (error) {
+    case AliroParseError::kBadRequest:
+        return "bad_request";
+    case AliroParseError::kUnknownKey:
+        return "unknown_key";
+    case AliroParseError::kInvalidValue:
+        return "invalid_value";
+    case AliroParseError::kNone:
+        break;
+    }
+    return "internal";
+}
