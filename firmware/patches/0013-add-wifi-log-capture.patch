+// ---- Recent-log ring ----
+//
+// 16 KiB static ring hooked into esp_log via esp_log_set_vprintf.
+// The sink is reentrant, formats outside the ring lock, never
+// allocates, and never calls ESP_LOG. The prior serial vprintf is
+// preserved and invoked with an independent va_copy so the console
+// output is unchanged. The snapshot allocates its heap buffer
+// BEFORE taking the lock, copies bytes chronologically UNDER the
+// lock, then releases the lock BEFORE the HTTP send.
+//
+// The ring lock is a portMUX spinlock (not a FreeRTOS mutex): the
+// sink must never silently drop diagnostic data, so it cannot use a
+// no-wait mutex take; a critical section guarantees every formatted
+// message reaches the ring, and the bounded 256-byte memcpy under
+// the critical section is short enough to keep priority-inversion
+// pressure negligible.
+constexpr size_t     kLogRingSize     = 16 * 1024;
+constexpr size_t     kLogLineMax      = 256;
+constexpr char       kLogTruncMarker[] = "...[log truncated]\n";
+constexpr size_t     kLogTruncMarkerLen = sizeof(kLogTruncMarker) - 1;
+portMUX_TYPE         s_log_lock       = portMUX_INITIALIZER_UNLOCKED;
+char                 s_log_ring[kLogRingSize];
+size_t               s_log_head       = 0;
+bool                 s_log_wrapped    = false;
+vprintf_like_t       s_prev_vprintf   = nullptr;
+bool                 s_log_installed  = false;

