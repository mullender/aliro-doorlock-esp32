+// ---- Recent-log ring ----
+//
+// 16 KiB static ring hooked into esp_log via esp_log_set_vprintf.
+// The sink is reentrant, formats outside the lock, never allocates,
+// and never calls ESP_LOG. The prior serial vprintf is preserved
+// and invoked with an independent va_copy so the console output is
+// unchanged. The snapshot allocates its heap buffer BEFORE taking
+// the lock, copies bytes chronologically UNDER the lock, then
+// releases the lock BEFORE the HTTP send.
+//
+// The single s_log_lock is a statically initialised portMUX that
+// serialises every read and every write of s_prev_vprintf and
+// s_log_installed AND the bounded ring copy. Holding a portMUX
+// while calling esp_log_set_vprintf is safe because that IDF
+// entry point is a single __atomic_exchange_n(..., SEQ_CST) with
+// no internal mutex. The callback takes the portMUX only long
+// enough to copy the prior-sink pointer + installed state, then
+// releases it before invoking the prior sink or formatting, and
+// reacquires it for the small bounded ring write.
+constexpr size_t     kLogRingSize     = 16 * 1024;
+constexpr size_t     kLogLineMax      = 256;
+constexpr char       kLogTruncMarker[] = "...[log truncated]\n";
+constexpr size_t     kLogTruncMarkerLen = sizeof(kLogTruncMarker) - 1;
+portMUX_TYPE         s_log_lock       = portMUX_INITIALIZER_UNLOCKED;
+char                 s_log_ring[kLogRingSize];
+size_t               s_log_head       = 0;
+bool                 s_log_wrapped    = false;
+vprintf_like_t       s_prev_vprintf   = nullptr;
+bool                 s_log_installed  = false;

