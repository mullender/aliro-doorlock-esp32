+extern "C" esp_err_t AliroLocalWebLogInit(void)
+{
+    // Idempotent under s_log_lock: two concurrent callers see
+    // exactly one esp_log_set_vprintf exchange, and the
+    // installed-flag + prior-vprintf publication happens under
+    // the same lock. esp_log_set_vprintf is a single
+    // __atomic_exchange_n(..., SEQ_CST) in IDF, so it is safe
+    // to invoke inside a portMUX critical section.
+    portENTER_CRITICAL_SAFE(&s_log_lock);
+    if (!s_log_installed)
+    {
+        vprintf_like_t prev = esp_log_set_vprintf(&log_sink_vprintf);
+        // Never store our own sink as the prior: if an external
+        // caller installed us then re-installed something that
+        // captured us, we would otherwise recurse forever.
+        if (prev != &log_sink_vprintf)
+        {
+            s_prev_vprintf = prev;
+        }
+        s_log_installed = true;
+    }
+    portEXIT_CRITICAL_SAFE(&s_log_lock);
+    return ESP_OK;
+}
