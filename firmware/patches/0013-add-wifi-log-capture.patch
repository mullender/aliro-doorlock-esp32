+// ---- /api/logs ----
+//
+// Reentrant sink: format OUTSIDE the ring lock into a stack buffer,
+// then enter a bounded critical section to copy into the ring. The
+// critical section replaces a FreeRTOS mutex on purpose: a no-wait
+// take would silently drop diagnostic data, and a blocking take on
+// a contended mutex could stall the caller for the duration of a
+// snapshot's memcpy. The critical section only wraps the ~ <=256 B
+// byte copy, so priority-inversion pressure is negligible; it also
+// keeps the sink callable from any task context. NEVER call
+// ESP_LOG or allocate here.
+int log_sink_vprintf(const char * fmt, va_list args)
+{
+    va_list to_serial;
+    va_copy(to_serial, args);
+    int written = 0;
+    if (s_prev_vprintf != nullptr)
+    {
+        written = s_prev_vprintf(fmt, to_serial);
+    }
+    va_end(to_serial);

+    if (!s_log_installed)
+    {
+        return written;
+    }
+
+    char line[kLogLineMax];
+    va_list to_ring;
+    va_copy(to_ring, args);
+    int n = vsnprintf(line, sizeof(line), fmt, to_ring);
+    va_end(to_ring);
+    if (n < 0)
+    {
+        return written;
+    }
+
+    // If vsnprintf truncated (return value >= buffer size), rewrite
+    // the tail of `line` with a clear truncation marker so a reader
+    // of the snapshot sees the loss instead of a silently cropped
+    // message. `len` is the number of bytes we actually push to the
+    // ring.
+    size_t len;
+    if (static_cast<size_t>(n) >= sizeof(line))
+    {
+        const size_t head_len = sizeof(line) - 1 - kLogTruncMarkerLen;
+        memcpy(line + head_len, kLogTruncMarker, kLogTruncMarkerLen);
+        len = head_len + kLogTruncMarkerLen;
+    }
+    else
+    {
+        len = static_cast<size_t>(n);
+    }
+
+    portENTER_CRITICAL_SAFE(&s_log_lock);
+    for (size_t i = 0; i < len; ++i)
+    {
+        s_log_ring[s_log_head] = line[i];
+        s_log_head = (s_log_head + 1) % kLogRingSize;
+        if (s_log_head == 0)
+        {
+            s_log_wrapped = true;
+        }
+    }
+    portEXIT_CRITICAL_SAFE(&s_log_lock);
+
+    return written;
+}
+
+// Copy the recent-log ring into a caller-owned heap buffer in
+// chronological order. Allocates BEFORE the critical section, copies
+// UNDER the critical section, releases the section BEFORE the caller
+// sends the response. Caller must free(*out).
+esp_err_t log_ring_snapshot(char ** out, size_t * out_len)
+{
+    *out = nullptr;
+    *out_len = 0;
+    if (!s_log_installed)
+    {
+        return ESP_ERR_INVALID_STATE;
+    }
+    char * buf = static_cast<char *>(malloc(kLogRingSize));
+    if (buf == nullptr)
+    {
+        return ESP_ERR_NO_MEM;
+    }
+    size_t total = 0;
+    portENTER_CRITICAL_SAFE(&s_log_lock);
+    if (s_log_wrapped)
+    {
+        // Chronological order: bytes from head to end first, then 0..head.
+        size_t tail_len = kLogRingSize - s_log_head;
+        memcpy(buf, s_log_ring + s_log_head, tail_len);
+        memcpy(buf + tail_len, s_log_ring, s_log_head);
+        total = kLogRingSize;
+    }
+    else
+    {
+        memcpy(buf, s_log_ring, s_log_head);
+        total = s_log_head;
+    }
+    portEXIT_CRITICAL_SAFE(&s_log_lock);
+    *out = buf;
+    *out_len = total;
+    return ESP_OK;
+}
+
+esp_err_t logs_get_handler(httpd_req_t * req)
+{
+    char * buf = nullptr;
+    size_t len = 0;
+    esp_err_t err = log_ring_snapshot(&buf, &len);
+    if (err == ESP_ERR_NO_MEM)
+    {
+        return send_json_error(req, "503 Service Unavailable", "out_of_memory");
+    }
+    if (err != ESP_OK)
+    {
+        return send_json_error(req, "500 Internal Server Error", "log_ring_unavailable");
+    }
+    httpd_resp_set_type(req, "text/plain; charset=utf-8");
+    httpd_resp_set_hdr(req, "Cache-Control", "no-store");
+    esp_err_t send_err = httpd_resp_send(req, buf, len);
+    free(buf);
+    return send_err;
+}
