+extern "C" esp_err_t AliroLocalWebLogInit(void)
+{
+    // Idempotent on repeat calls. The ring lock is a portMUX that
+    // is statically initialised, so nothing needs to be created
+    // here — installing the sink once and capturing the previous
+    // serial vprintf is all the state we need to keep.
+    if (!s_log_installed)
+    {
+        s_prev_vprintf = esp_log_set_vprintf(&log_sink_vprintf);
+        s_log_installed = true;
+    }
+    return ESP_OK;
+}
